<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 p-6">

    <div class="container mx-auto">
        <h1 class="text-4xl text-center font-extrabold text-gray-800 mb-8">📦 Inventory Management</h1>

        <!-- Inventory Table -->
        <div class="overflow-x-auto">
            <table class="w-full bg-white shadow-lg rounded-lg overflow-hidden">
                <thead class="bg-blue-600 text-white text-left">
                    <tr>
                        <th class="py-3 px-6">Name</th>
                        <th class="py-3 px-6">Quantity</th>
                        <th class="py-3 px-6">Price</th>
                        <th class="py-3 px-6">Actions</th>
                    </tr>
                </thead>
                <tbody id="inventoryTable" class="text-gray-700">
                    <% items.forEach(item => { %>
                        <tr class="border-t hover:bg-gray-100 transition duration-200" id="row-<%= item._id %>">
                            <td class="py-4 px-6">
                                <span id="name-<%= item._id %>" class="font-medium"><%= item.name %></span>
                                <input id="edit-name-<%= item._id %>" class="hidden border p-1 w-full rounded" type="text" value="<%= item.name %>">
                            </td>
                            <td class="py-4 px-6">
                                <span id="quantity-<%= item._id %>"><%= item.quantity %></span>
                                <input id="edit-quantity-<%= item._id %>" class="hidden border p-1 w-full rounded" type="number" value="<%= item.quantity %>">
                            </td>
                            <td class="py-4 px-6">
                                <span id="price-<%= item._id %>">₹<%= item.price %></span>
                                <input id="edit-price-<%= item._id %>" class="hidden border p-1 w-full rounded" type="number" value="<%= item.price %>">
                            </td>
                            <td class="py-4 px-6 flex space-x-2">
                                <button onclick="editItem('<%= item._id %>')" class="bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-1 rounded transition">✏ Edit</button>
                                <button onclick="saveItem('<%= item._id %>')" class="bg-green-500 hover:bg-green-600 text-white px-4 py-1 rounded hidden transition" id="save-<%= item._id %>">✔ Save</button>
                                <button onclick="deleteItem('<%= item._id %>')" class="bg-red-500 hover:bg-red-600 text-white px-4 py-1 rounded transition">🗑 Delete</button>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <!-- Add New Item Form -->
        <div class="mt-10 bg-white p-6 shadow-md rounded-lg max-w-lg mx-auto">
            <h2 class="text-2xl font-bold text-gray-800 mb-4">➕ Add New Item</h2>
            <div class="mb-4">
                <label class="block text-gray-600 mb-1">Item Name</label>
                <input id="name" type="text" placeholder="Enter item name" class="border border-gray-300 rounded-lg p-2 w-full focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="mb-4">
                <label class="block text-gray-600 mb-1">Quantity</label>
                <input id="quantity" type="number" placeholder="Enter quantity" class="border border-gray-300 rounded-lg p-2 w-full focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="mb-4">
                <label class="block text-gray-600 mb-1">Price (₹)</label>
                <input id="price" type="number" placeholder="Enter price" class="border border-gray-300 rounded-lg p-2 w-full focus:ring-2 focus:ring-blue-500">
            </div>
            <button onclick="addItem()" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-lg font-semibold w-full transition">Add Item</button>
        </div>
    </div>

    <script>
        // Function to Add New Item
        async function addItem() {
            const name = document.getElementById('name').value;
            const quantity = document.getElementById('quantity').value;
            const price = document.getElementById('price').value;

            if (!name || !quantity || !price) {
                alert("Please fill out all fields.");
                return;
            }

            const response = await fetch('/inventory', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, quantity, price })
            });

            if (response.ok) {
                alert('Item Added Successfully!');
                location.reload();
            } else {
                alert('Error adding item.');
            }
        }

        // Function to Delete an Item
        async function deleteItem(id) {
            if (!confirm("Are you sure you want to delete this item?")) return;

            const response = await fetch(`/inventory/${id}`, { method: 'DELETE' });

            if (response.ok) {
                alert('Item Deleted Successfully!');
                location.reload();
            } else {
                alert('Error deleting item.');
            }
        }

        // Function to Edit an Item (Show Input Fields)
        function editItem(id) {
            document.getElementById(`name-${id}`).classList.add('hidden');
            document.getElementById(`quantity-${id}`).classList.add('hidden');
            document.getElementById(`price-${id}`).classList.add('hidden');

            document.getElementById(`edit-name-${id}`).classList.remove('hidden');
            document.getElementById(`edit-quantity-${id}`).classList.remove('hidden');
            document.getElementById(`edit-price-${id}`).classList.remove('hidden');

            document.getElementById(`save-${id}`).classList.remove('hidden');
        }

        // Function to Save Updated Item
        async function saveItem(id) {
            const name = document.getElementById(`edit-name-${id}`).value;
            const quantity = document.getElementById(`edit-quantity-${id}`).value;
            const price = document.getElementById(`edit-price-${id}`).value;

            if (!name || !quantity || !price) {
                alert("Please fill out all fields.");
                return;
            }

            const response = await fetch(`/inventory/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, quantity, price })
            });

            if (response.ok) {
                alert('Item Updated Successfully!');
                location.reload();
            } else {
                alert('Error updating item.');
            }
        }
    </script>
</body>
</html>